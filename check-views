#!/usr/bin/env bash
# Creates each view of views.sql alone against the real buckets and counts its rows; an empty view or one that does not
# create fails, while an optional view, whose producer may not run in this profile, may be empty but must create.
# Exits 0 if every view is as expected, 3 if any is not, 1 if the check could not be made; `DUCKDB` sets the binary.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

duckdb="${DUCKDB:-duckdb}"
for variable in AWS_S3_ARCHIVE_BUCKET_NAME AWS_S3_RECORDS_BUCKET_NAME; do
  if [[ -z "${!variable:-}" ]]; then
    echo "Error: ${variable} is not set" >&2
    exit 1
  fi
done

mapfile -t views < <(sed -nE 's/^CREATE OR REPLACE VIEW ([a-z0-9_]+) AS$/\1/p' views.sql)
declarations="$(grep -cE '^CREATE( OR REPLACE)? VIEW' views.sql || true)"
# A declaration the pattern misses would otherwise go unchecked while the rest pass.
if [[ ${#views[@]} -eq 0 || ${#views[@]} -ne ${declarations} ]]; then
  echo "Error: read ${#views[@]} views from ${declarations} declarations in views.sql" >&2
  exit 1
fi

case "${FUND_PROFILE:-}" in
  # A developer's studies may ship researcher journals and a developer's paper trader its journal and logs.
  development | development/*)
    optional=" journal logs experiments bar_seam "
    ;;
  # The archiver ships production's journal and logs nightly; the researcher and trader records may be absent.
  *)
    optional=" experiments bar_seam "
    ;;
esac

unwritten='No files found that match the pattern'
preamble="$(awk '/^CREATE OR REPLACE VIEW /{exit} {print}' views.sql)"
broken=0
live=0
unreachable=0
for view in "${views[@]}"; do
  statement="$(awk -v start="CREATE OR REPLACE VIEW ${view} AS" \
    '$0 == start {inside = 1} inside {print} inside && /;[[:space:]]*$/ {exit}' views.sql)"
  # Bailing on the first error keeps a failed creation from adding a second error of its own.
  if output="$(printf '%s\n.bail on\n%s\nSELECT count(*) FROM %s;\n' "${preamble}" "${statement}" "${view}" \
    | "${duckdb}" -csv -noheader 2>&1)"; then
    rows="$(grep -E '^[0-9]+$' <<<"${output}" | tail -n 1 || true)"
  else
    rows=""
  fi
  error="$(grep -m 1 'Error' <<<"${output}" || true)"
  if [[ "${optional}" == *" ${view} "* ]]; then
    if [[ -n "${rows}" ]]; then
      echo "${view}: optional, ${rows} rows"
    elif [[ "${error}" == *"${unwritten}"* ]]; then
      echo "${view}: optional, nothing written"
    else
      echo "${view}: optional, and did not create: ${error:-${output}}"
      broken=$((broken + 1))
    fi
    continue
  fi
  live=$((live + 1))
  if [[ -z "${rows}" ]]; then
    echo "${view}: did not create: ${error:-${output}}"
    broken=$((broken + 1))
    # A glob that matches nothing reached S3 and is the view's own fault; anything else may be S3 out of reach.
    if [[ "${error}" != *"${unwritten}"* ]]; then
      unreachable=$((unreachable + 1))
    fi
  elif [[ "${rows}" -eq 0 ]]; then
    echo "${view}: reads no rows"
    broken=$((broken + 1))
  else
    echo "${view}: ${rows} rows"
  fi
done

# Every live view out of reach is the check failing to reach S3, not every view breaking at once.
if [[ "${live}" -gt 0 && "${unreachable}" -eq "${live}" ]]; then
  echo "Error: no live view could be read; the check was not made" >&2
  exit 1
fi
if [[ "${broken}" -gt 0 ]]; then
  echo "${broken} of ${#views[@]} views are not as this profile expects"
  exit 3
fi
echo "All ${live} live views read rows"
