#!/usr/bin/env bash
# The EC2 wrapper around `run-role`: syncs to master, runs the role inside devenv once at boot, then powers off.
# The role and profile are the instance's `fund-role` and `fund-profile` tags; a `fund-hold` tag runs nothing.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"

# Brings Nix and devenv to the releases master pins; a failed upgrade is logged and the role runs on what is installed.
converge() {
  # shellcheck source=host/versions
  source host/versions
  if ! nix --version | grep -qF "Determinate Nix ${NIX_VERSION})"; then
    echo "Upgrading Nix from $(nix --version) to ${NIX_VERSION}"
    sudo determinate-nixd upgrade --version "${NIX_VERSION}" || echo "Error: Nix upgrade failed; running on $(nix --version)"
  fi
  local installed
  installed="$(installed_devenv_version)"
  if [[ "$installed" != "$DEVENV_VERSION" ]]; then
    echo "Replacing devenv ${installed} with ${DEVENV_VERSION}"
    nix profile remove devenv
    if ! nix profile install --accept-flake-config "github:cachix/devenv/v${DEVENV_VERSION}"; then
      echo "Error: devenv ${DEVENV_VERSION} failed to install; restoring ${installed}"
      nix profile install --accept-flake-config "github:cachix/devenv/v${installed}"
    fi
  fi
}

metadata() {
  local token
  token="$(curl -sf -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 60")"
  curl -sf -H "X-aws-ec2-metadata-token: $token" "http://169.254.169.254/latest/meta-data/$1"
}

# A hang anywhere powers the box off after 26 hours; a scheduled role is stopped well before.
sudo shutdown -P +1560 || echo "Error: the 26-hour backstop power-off could not be scheduled"

# Left up rather than powered off: an unreadable hold may be an operator's, and the backstop still bounds the box.
if ! tags="$(metadata tags/instance)"; then
  echo "Error: instance tags are unreadable; leaving the box up for the backstop"
  exit 1
fi
if grep -qx fund-hold <<<"$tags"; then
  echo "Held by fund-hold ($(metadata tags/instance/fund-hold || true)); running nothing and staying up"
  sudo shutdown -c || echo "Error: the 26-hour backstop power-off could not be cancelled"
  exit 0
fi

# Publishes the run's outcome for the role's alarms, then powers off whether or not the publish succeeded.
finish() {
  local status=$? metric=RunCompleted
  [[ "$status" -eq 0 ]] || metric=RunFailed
  echo "Run exited ${status}; publishing fund/${metric}"
  timeout 300 devenv shell -- aws cloudwatch put-metric-data --namespace fund --metric-name "$metric" --value 1 \
    --unit Count --dimensions "role=${role:-none},profile=${profile:-none}" \
    || echo "Error: fund/${metric} could not be published"
  echo "Powering off"
  sudo systemctl poweroff
}
trap finish EXIT

role="$(metadata tags/instance/fund-role || true)"
profile="$(metadata tags/instance/fund-profile || true)"
AWS_REGION="$(metadata placement/region)"
export AWS_REGION FUND_PROFILE="$profile" SECRETSPEC_PROFILE="$profile"
echo "Running role ${role:-<none>} under profile ${profile:-<none>}"

# One compound command, so bash has parsed the rest before the reset rewrites this file underneath it.
{
  if git fetch -q origin master; then
    git reset -q --hard origin/master
  else
    echo "Error: git fetch failed; keeping $(git rev-parse --short HEAD)"
  fi
  converge
  devenv shell -- host/run-role "$role"
  exit
}
