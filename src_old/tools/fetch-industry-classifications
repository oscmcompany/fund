#!/usr/bin/env bash
# Publishes the Fama-French SIC runs, and regenerates the bucket names they refer to.
#
# Two outputs with different homes. The runs go to S3 as an `as_of`-partitioned dataset, so moving
# one needs no deploy. The bucket names stay in src/data/classification_table.rs, because the code
# matches on them, and that file is committed.
#
# The table decides which names share a sector, which the screen's concentration cap and the
# laboratory's sector factor are both read off. That grouping is re-derived on every read, so a
# study run today and the book selected tonight group names identically only if they used the same
# mapping -- which is why every reader journals `classification_as_of` rather than why the runs are
# compiled in. They are not, any more.
#
#   tools/fetch-industry-classifications
#   tools/fetch-industry-classifications --check
#
# `--check` writes nothing and exits 3 when either output has moved, matching
# `fetch-trade-conditions`; any other non-zero status means the check could not be made. Not a
# test: it needs the network, and a suite that fails when Dartmouth is down stops meaning anything.
#
# The order is not optional. A run naming a bucket this repository has not committed is refused,
# because the vocabulary is compiled in: publishing it first would make every deployed binary refuse
# the whole mapping. Commit and deploy the vocabulary, then publish.
#
# Two granularities from one source. The 12-industry file is the sector -- coarse enough that the
# screen's per-sector cap can bind at all -- and the 49-industry file is the subgroup beneath it.
# They are separate files rather than a rollup, because Fama and French fit each independently: a
# 49-industry bucket is not guaranteed to sit inside one 12-industry bucket, and deriving the coarse
# level from the fine one would invent a nesting the source does not claim.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Entered rather than merely resolved: `cargo fmt` below reads the manifest from the working
# directory, so a run from anywhere but the repository root would format nothing and say so quietly.
cd "${ROOT}"
OUTPUT="${ROOT}/src/data/classification_table.rs"

BASE_URL="https://mba.tuck.dartmouth.edu/pages/faculty/ken.french/ftp"

# Distinct from 1, which every refusal below uses, so a caller can tell drift from a failed check.
DRIFT_STATUS=3

CHECK_ONLY=false
if [[ "${1:-}" == "--check" ]]; then
  CHECK_ONLY=true
elif [[ -n "${1:-}" ]]; then
  echo "Usage: $(basename "$0") [--check]" >&2
  exit 1
fi

WORK="$(mktemp -d)"
# A command that fails under `set -e` exits with its own status, and curl's include 3, so a failed
# check would read as drift. Only the line that decides drift may leave with that status.
DRIFT_DECLARED=false
leave() {
  local status=$?
  rm -rf "${WORK}"
  if [[ "${status}" -eq "${DRIFT_STATUS}" && "${DRIFT_DECLARED}" != true ]]; then
    exit 1
  fi
  exit "${status}"
}
trap leave EXIT

for granularity in 12 49; do
  echo "Fetching Siccodes${granularity} from ${BASE_URL}"
  curl -sS --fail-with-body -L -o "${WORK}/Siccodes${granularity}.zip" \
    "${BASE_URL}/Siccodes${granularity}.zip"
  unzip -o -q -d "${WORK}" "${WORK}/Siccodes${granularity}.zip"
done

TARGET="${OUTPUT}"
if [[ "${CHECK_ONLY}" == true ]]; then
  TARGET="${WORK}/generated.rs"
fi
RANGES_CSV="${WORK}/ranges.csv"
RANGES_PARQUET="${WORK}/ranges.parquet"

python3 - "${WORK}" "${TARGET}" "${RANGES_CSV}" <<'PYTHON'
import csv
import re
import sys
from datetime import date

work, output, ranges_csv = sys.argv[1], sys.argv[2], sys.argv[3]

# The name each bucket is spelled with, keyed by the source's own short code.
#
# Curated rather than derived, because neither end of the source is usable on its own: the short
# codes are abbreviations ("Enrgy", "Hshld", "RlEst") and the full labels are descriptions that would
# read as "OilGasAndCoalExtractionAndProducts". These are the shortest full-word names that keep the
# label's meaning; the label itself is carried verbatim onto each variant's doc comment, so nothing
# the source says is lost. Asserted complete below, so a bucket added upstream fails the generation
# rather than quietly falling back to an abbreviation.
SECTOR_NAMES = {
    "NoDur": "ConsumerNondurables",
    "Durbl": "ConsumerDurables",
    "Manuf": "Manufacturing",
    "Enrgy": "Energy",
    "Chems": "Chemicals",
    "BusEq": "BusinessEquipment",
    "Telcm": "Telecommunications",
    "Utils": "Utilities",
    "Shops": "WholesaleAndRetail",
    "Hlth": "Healthcare",
    "Money": "Finance",
    "Other": "Other",
}

INDUSTRY_NAMES = {
    "Agric": "Agriculture",
    "Food": "FoodProducts",
    "Soda": "CandyAndSoda",
    "Beer": "BeerAndLiquor",
    "Smoke": "TobaccoProducts",
    "Toys": "Recreation",
    "Fun": "Entertainment",
    "Books": "PrintingAndPublishing",
    "Hshld": "ConsumerGoods",
    "Clths": "Apparel",
    "Hlth": "Healthcare",
    "MedEq": "MedicalEquipment",
    "Drugs": "PharmaceuticalProducts",
    "Chems": "Chemicals",
    "Rubbr": "RubberAndPlasticProducts",
    "Txtls": "Textiles",
    "BldMt": "ConstructionMaterials",
    "Cnstr": "Construction",
    "Steel": "SteelWorks",
    "FabPr": "FabricatedProducts",
    "Mach": "Machinery",
    "ElcEq": "ElectricalEquipment",
    "Autos": "AutomobilesAndTrucks",
    "Aero": "Aircraft",
    "Ships": "ShipbuildingAndRailroadEquipment",
    "Guns": "Defense",
    "Gold": "PreciousMetals",
    "Mines": "NonMetallicAndIndustrialMetalMining",
    "Coal": "Coal",
    "Oil": "PetroleumAndNaturalGas",
    "Util": "Utilities",
    "Telcm": "Communication",
    "PerSv": "PersonalServices",
    "BusSv": "BusinessServices",
    "Hardw": "Computers",
    "Softw": "ComputerSoftware",
    "Chips": "ElectronicEquipment",
    "LabEq": "MeasuringAndControlEquipment",
    "Paper": "BusinessSupplies",
    "Boxes": "ShippingContainers",
    "Trans": "Transportation",
    "Whlsl": "Wholesale",
    "Rtail": "Retail",
    "Meals": "RestaurantsHotelsMotels",
    "Banks": "Banking",
    "Insur": "Insurance",
    "RlEst": "RealEstate",
    "Fin": "Trading",
    "Other": "Other",
}


def named(buckets, names, granularity):
    """Attaches the spelled-out name to each bucket, refusing a source the map does not cover."""
    missing = [bucket["code"] for bucket in buckets if bucket["code"] not in names]
    if missing:
        sys.exit(
            f"Error: Siccodes{granularity} names buckets the generator has no full name for: "
            f"{missing}. Add them to the map above rather than letting an abbreviation through."
        )
    for bucket in buckets:
        bucket["name"] = names[bucket["code"]]
    spelled = [bucket["name"] for bucket in buckets]
    if len(set(spelled)) != len(spelled):
        sys.exit(f"Error: two Siccodes{granularity} buckets spell the same name: {spelled}")
    return buckets


def parse(granularity):
    """The buckets in file order, each with the SIC ranges assigned to it.

    Order is the source's own, which is what makes a variant list reviewable against the published
    file. The catch-all bucket is last in both files and is the only one allowed to carry no ranges.
    """
    buckets = []
    # Latin-1 rather than UTF-8: the 49-industry file spells at least one range description with a
    # byte that is not valid UTF-8, and decoding it strictly would fail on a line this reads past.
    with open(f"{work}/Siccodes{granularity}.txt", encoding="latin-1") as handle:
        for line in handle:
            heading = re.match(r"\s*(\d+)\s+(\w+)\s+(.*?)\s*$", line)
            span = re.match(r"\s+(\d{4})-(\d{4})", line)
            if span and buckets:
                buckets[-1]["ranges"].append((int(span.group(1)), int(span.group(2))))
            elif heading:
                buckets.append(
                    {
                        "number": int(heading.group(1)),
                        "code": heading.group(2),
                        "label": heading.group(3),
                        "ranges": [],
                    }
                )
    if len(buckets) != granularity:
        sys.exit(f"Error: Siccodes{granularity} named {len(buckets)} buckets, not {granularity}")
    if [bucket["number"] for bucket in buckets] != list(range(1, granularity + 1)):
        sys.exit(f"Error: Siccodes{granularity} is not numbered 1..{granularity} in file order")
    for bucket in buckets[:-1]:
        if not bucket["ranges"]:
            sys.exit(f"Error: Siccodes{granularity} bucket {bucket['code']} carries no ranges")
    codes = [bucket["code"] for bucket in buckets]
    if len(set(codes)) != len(codes):
        sys.exit(f"Error: Siccodes{granularity} repeats a bucket code, so the variants would collide")
    for code in codes:
        if not re.fullmatch(r"[A-Za-z][A-Za-z0-9]*", code):
            sys.exit(f"Error: {code!r} is not usable as a Rust variant name")
    return buckets


def overlaps(buckets, granularity):
    """Every SIC range, sorted, refusing two buckets that claim the same code.

    A published overlap would make the lookup depend on file order, so it is refused here rather
    than resolved: first-match would silently pick one and the two granularities would disagree
    about a name for a reason no reader could see.
    """
    spans = [
        (low, high, bucket["name"]) for bucket in buckets for (low, high) in bucket["ranges"]
    ]
    spans.sort()

    # Every span on its own before any pair, because a pairwise loop never reaches the last span --
    # and reaches none at all in a one-span file.
    for low, high, code in spans:
        if low > high:
            sys.exit(
                f"Error: Siccodes{granularity} assigns {low}-{high} to {code}, which runs backwards"
            )

    for (low, high, code), (next_low, next_high, next_code) in zip(spans, spans[1:]):
        if next_low <= high:
            sys.exit(
                f"Error: Siccodes{granularity} assigns {next_low}-{next_high} to {next_code} while "
                f"{low}-{high} already belongs to {code}"
            )
    return spans


def render_enum(name, buckets, doc, fallback_doc):
    lines = [
        *doc,
        "#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]",
        f"pub enum {name} {{",
    ]
    for bucket in buckets:
        label = bucket["label"]
        if bucket is buckets[-1]:
            lines.extend(f"    /// {line}" for line in fallback_doc)
        else:
            lines.append(f"    /// {label}")
        lines.append(f"    {bucket['name']},")
    lines.append("}")
    lines.append("")
    lines.append(f"impl {name} {{")
    lines.append("    /// The stored form, which round-trips through the module's decode.")
    lines.append("    pub fn as_str(&self) -> &'static str {")
    lines.append("        match self {")
    for bucket in buckets:
        lines.append(f'            {name}::{bucket["name"]} => "{bucket["name"]}",')
    lines.append("        }")
    lines.append("    }")
    lines.append("")
    lines.append("    /// Every bucket, in the source's own order.")
    lines.append(f"    pub const ALL: [{name}; {len(buckets)}] = [")
    for bucket in buckets:
        lines.append(f"        {name}::{bucket['name']},")
    lines.append("    ];")
    lines.append("}")
    lines.append("")
    return lines


sectors = named(parse(12), SECTOR_NAMES, 12)
industries = named(parse(49), INDUSTRY_NAMES, 49)
sector_spans = overlaps(sectors, 12)
industry_spans = overlaps(industries, 49)

lines = [
    "//! The Fama-French industry definitions, generated — see `tools/fetch-industry-classifications`.",
    "//!",
    "//! Edit the script, never this file. [`FETCHED_ON`] carries the date it was read.",
    "",
    "/// The date the published definitions were last read into this file.",
    "///",
    "/// The only line in this file that changes with the clock, which is what lets `--check` compare",
    "/// two generations by ignoring exactly one line.",
    f'pub const FETCHED_ON: &str = "{date.today().isoformat()}";',
    "",
]

lines.extend(
    render_enum(
        "Sector",
        sectors,
        [
            "/// The twelve Fama-French industries, which is what this system means by a sector.",
            "///",
            "/// Coarse on purpose. The screen's concentration cap is a question about how much of the",
            "/// book sits on one common factor, and a partition fine enough to separate two names that",
            "/// move together answers a different question.",
        ],
        [
            "Everything the source assigns to no other bucket.",
            "",
            "A real bucket -- mines, construction, building materials, transport, hotels, business",
            "services, entertainment -- and not a synonym for an unclassified name. A name with no SIC",
            "code at all is `None`, and the two must not be folded together: this one names a group",
            "that shares a factor, and the other names the absence of an answer.",
        ],
    )
)

lines.extend(
    render_enum(
        "Industry",
        industries,
        [
            "/// The forty-nine Fama-French industries, the subgroup beneath [`Sector`].",
            "///",
            "/// Not nested inside `Sector`: the two are fitted independently by the source, so a name's",
            "/// industry does not determine its sector and neither is derived from the other.",
        ],
        [
            "Everything the source assigns to no other bucket.",
            "",
            "Named \"Almost Nothing\" in the source, and carrying ranges of its own rather than being",
            "purely a fallback. As with `Sector::Other`, this is a group and not an absence.",
        ],
    )
)

lines.extend(
    [
        "/// One contiguous run of SIC codes, and the bucket the source assigns it to.",
        "///",
        "/// Both bounds are inclusive, and the runs are disjoint and ascending — the generator refuses",
        "/// a published overlap rather than resolving it, so a lookup may stop at the first hit.",
        "#[derive(Debug, Clone, Copy, PartialEq, Eq)]",
        "pub struct SicRange<Bucket: 'static> {",
        "    pub low: u16,",
        "    pub high: u16,",
        "    pub bucket: Bucket,",
        "}",
        "",
    ]
)

# The runs themselves are published as a dataset rather than emitted here, so moving one needs no
# deploy. Only the vocabulary -- the bucket names the runs refer to -- stays compiled in.
# lineterminator explicitly: csv.writer defaults to CRLF, and the shell reads this file back to
# check bucket names, where a trailing carriage return makes every name fail to match.
with open(ranges_csv, "w", newline="") as handle:
    writer = csv.writer(handle, lineterminator="\n")
    writer.writerow(["granularity", "low", "high", "bucket"])
    for low, high, code in sector_spans:
        writer.writerow(["sector", low, high, code])
    for low, high, code in industry_spans:
        writer.writerow(["industry", low, high, code])

rendered = "\n".join(lines)

# `--check` compares two generations by ignoring the one dated line, so a second one would make an
# unchanged table read as drift a day later. That is exactly the bug this guard exists to prevent,
# and it is asserted here rather than trusted because the failure only appears the next morning.
dated = [
    line
    for line in rendered.splitlines()
    if re.search(r"\d{4}-\d{2}-\d{2}", line) and not line.startswith("pub const FETCHED_ON")
]
if dated:
    sys.exit(
        "Error: the generated file carries a date outside FETCHED_ON, which would make --check "
        f"report drift every day: {dated}"
    )

with open(output, "w") as handle:
    handle.write(rendered)

print(
    f"Wrote {len(sectors)} sector and {len(industries)} industry names to {output}, "
    f"and {len(sector_spans)} + {len(industry_spans)} ranges to {ranges_csv}"
)
PYTHON

# Both paths, and `--check` is why. The committed table is formatted, so comparing it against an
# unformatted generation reports drift on every run: rustfmt splits each `SicRange` literal across
# five lines and the generator emits it on one. `rustfmt` directly rather than `cargo fmt`, which
# takes its file list relative to the manifest and cannot reach the temporary file below.
echo "Formatting"
rustfmt --edition 2021 "${TARGET}"

# The ranges go to S3 as a dataset. duckdb rather than a Rust helper, because nothing in the binary
# should be able to write this: the archive reads it, and a writer in the same process is a way for a
# run to quietly reclassify the universe it is measuring.
echo "Encoding the ranges"
duckdb -c "COPY (SELECT granularity, CAST(low AS UINTEGER) AS low, CAST(high AS UINTEGER) AS high, \
  bucket FROM read_csv('${RANGES_CSV}', header = true)) TO '${RANGES_PARQUET}' (FORMAT parquet);"

# The vocabulary as committed, not as just regenerated: python has already overwritten the working
# tree, and what deployed binaries know is what is on HEAD. A run naming a bucket absent from it
# would load as `UnknownBucket` and take down every reader until the new binary ships.
echo "Checking the runs against the committed vocabulary"
COMMITTED_VOCABULARY="${WORK}/committed_vocabulary.rs"
if git show "HEAD:src/data/classification_table.rs" > "${COMMITTED_VOCABULARY}" 2>/dev/null; then
  UNKNOWN=""
  while IFS= read -r bucket; do
    grep -q "=> \"${bucket}\"," "${COMMITTED_VOCABULARY}" || UNKNOWN="${UNKNOWN} ${bucket}"
  done < <(tail -n +2 "${RANGES_CSV}" | cut -d, -f4 | sort -u)
  if [[ -n "${UNKNOWN}" ]]; then
    echo "Error: the published runs name bucket(s) this repository has not committed:${UNKNOWN}" >&2
    echo "  Deployed binaries would refuse the whole mapping, not just these runs." >&2
    echo "  Commit src/data/classification_table.rs, deploy it, then re-run to publish." >&2
    exit 1
  fi
  echo "    every bucket is one the committed vocabulary names"
else
  echo "    no committed vocabulary to compare against; skipping" >&2
fi

BUCKET="${AWS_S3_ARCHIVE_BUCKET_NAME:-oscm-fund-archive}"
PREFIX="data/reference/classification"

# The newest stored partition, so a run that changes nothing writes nothing. Writing every fetch
# would make `as_of` mean "when we looked" rather than "when the definitions moved", and churn every
# reader's provenance for no change.
# Fail closed. A masked error here -- expired credentials, a denied listing -- would read as an
# empty prefix, and the script would answer "no stored mapping yet" and publish over whatever is
# actually there. Every key is listed and the maximum taken in the shell rather than by JMESPath,
# because `--query` with `--output text` is applied per page and a paginated listing would leave
# several keys in one variable.
ALL_KEYS="$(aws s3api list-objects-v2 --bucket "${BUCKET}" --prefix "${PREFIX}/" \
  --query 'Contents[].Key' --output text)"
# Only keys of the exact shape the loader reads. `conditions_as_of_dates` keeps a key only when it
# round-trips to `as_of=<date>/data.parquet`, so a nested `as_of=.../backup/data.parquet` would make
# this script answer "unchanged" while the loader kept folding under an older partition -- the two
# disagreeing about whether anything is wrong.
# `|| NEWEST_KEY=""` because an empty prefix makes `grep` match nothing, and `pipefail` turns that
# into a fatal error on the one run that most needs to succeed -- the first publish. The fail-closed
# property is untouched: the listing itself is a separate assignment and still aborts the script.
NEWEST_KEY="$(printf '%s' "${ALL_KEYS}" | tr '\t' '\n' \
  | grep -E "^${PREFIX}/as_of=[0-9]{4}-[0-9]{2}-[0-9]{2}/data\.parquet$" | sort | tail -1)" \
  || NEWEST_KEY=""
[[ -z "${NEWEST_KEY}" ]] && NEWEST_KEY="None"

UNCHANGED=false
if [[ "${NEWEST_KEY}" != "None" && -n "${NEWEST_KEY}" ]]; then
  aws s3 cp "s3://${BUCKET}/${NEWEST_KEY}" "${WORK}/stored.parquet" --quiet
  # Compared as a set of rows, not as bytes: parquet encoding is not reproducible, so a byte diff
  # would report drift on every run and stop meaning anything.
  # EXCEPT ALL, not EXCEPT: set semantics would call a stored object holding a duplicated run
  # identical to a clean one, so the tool would refuse to republish while the loader refuses to read
  # it as overlapping -- the two disagreeing about whether anything is wrong.
  DIFFERENCES="$(duckdb -noheader -list -c "SELECT count(*) FROM ( \
    (SELECT * FROM read_parquet('${RANGES_PARQUET}') EXCEPT ALL SELECT * FROM read_parquet('${WORK}/stored.parquet')) \
    UNION ALL \
    (SELECT * FROM read_parquet('${WORK}/stored.parquet') EXCEPT ALL SELECT * FROM read_parquet('${RANGES_PARQUET}')));")"
  if [[ "${DIFFERENCES}" == "0" ]]; then
    UNCHANGED=true
  fi
  echo "Stored ${NEWEST_KEY}: ${DIFFERENCES} differing row(s)"
else
  echo "No stored mapping yet; this run publishes the first"
fi

if [[ "${CHECK_ONLY}" == true ]]; then
  # Ignoring FETCHED_ON, which moves with the clock and says nothing about the source. It is the
  # only dated line by construction — the generator refuses to emit a second one — so this compares
  # the definitions themselves rather than the day they were read.
  undated() { grep -v '^pub const FETCHED_ON' "$1"; }
  VOCABULARY_MOVED=false
  diff <(undated "${OUTPUT}") <(undated "${TARGET}") >/dev/null || VOCABULARY_MOVED=true

  if [[ "${VOCABULARY_MOVED}" == false && "${UNCHANGED}" == true ]]; then
    echo "Up to date: both the vocabulary and the published ranges match"
    exit 0
  fi
  if [[ "${VOCABULARY_MOVED}" == true ]]; then
    echo "DRIFT: the bucket names no longer match the committed vocabulary" >&2
    diff <(undated "${OUTPUT}") <(undated "${TARGET}") >&2 || true
  fi
  if [[ "${UNCHANGED}" == false ]]; then
    echo "DRIFT: the published ranges differ from the newest stored partition" >&2
  fi
  echo >&2
  echo "Re-run without --check to republish, and commit any vocabulary diff." >&2
  DRIFT_DECLARED=true
  exit "${DRIFT_STATUS}"
fi

if [[ "${UNCHANGED}" == true ]]; then
  echo "Ranges unchanged; nothing published. Review any vocabulary diff and commit it."
  exit 0
fi

AS_OF="$(date -u +%Y-%m-%d)"
DESTINATION_KEY="${PREFIX}/as_of=${AS_OF}/data.parquet"
echo "Publishing s3://${BUCKET}/${DESTINATION_KEY}"

# `--if-none-match "*"` so a second change on one UTC day refuses rather than overwrites. The key is
# date-only and `classification_as_of` is the whole of a run's mapping provenance, so replacing it
# would silently change what every earlier run's record refers to. Conditional at S3 rather than a
# head-then-put, which has a window between the two calls.
if ! aws s3api put-object --bucket "${BUCKET}" --key "${DESTINATION_KEY}" \
  --body "${RANGES_PARQUET}" --if-none-match "*" >/dev/null 2>"${WORK}/put_error"; then
  if grep -q "PreconditionFailed\|At least one of the pre-conditions" "${WORK}/put_error"; then
    echo "Error: as_of=${AS_OF} already holds a different mapping." >&2
    echo "  Overwriting it would change what earlier runs' classification_as_of refers to." >&2
    echo "  Wait for the next UTC day, or delete that partition deliberately if it was never read." >&2
  else
    cat "${WORK}/put_error" >&2
  fi
  exit 1
fi

echo "Done. Review any vocabulary diff and commit it."
