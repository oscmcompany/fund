#!/usr/bin/env bash
set -euo pipefail

# sync-archiver -- Bring the archiver's checkout and binary up to origin/master.
#
# Runs on the worker itself, before each night's fold. Unlike `sync-application` there is no
# process-compose to signal, so this only has to leave a good binary behind.

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BINARY="$REPO_ROOT/target/release/seed"

# Which commit last built successfully here. Reported, never consulted to skip work: cargo decides
# freshness from the source files themselves, and a second answer to the same question is a second
# thing to be wrong. A hand-run `cargo build` desynchronises this file and must stay harmless.
STAMP="$REPO_ROOT/target/release/.seed-built-from"

log() {
  echo "$(date -u +"%Y-%m-%dT%H:%M:%SZ") $1"
}

# An SSM session and a cron entry both start without a login shell's PATH, so rustup's own entry
# is not there and cargo would be missing. HOME can be unset under cron, which `set -u` makes fatal.
if [[ -d "${HOME:-}/.cargo/bin" ]]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

cd "$REPO_ROOT"

if ! git fetch origin master 2>&1; then
  log "git fetch failed; keeping $(git rev-parse --short HEAD)"
  exit 0
fi

remote_head="$(git rev-parse origin/master)"
built_from="$(cat "$STAMP" 2>/dev/null || echo none)"

log "Syncing to ${remote_head:0:8} (last successful build: ${built_from:0:8})"
git reset --hard origin/master

# Built unconditionally. An up-to-date build is a freshness check cargo answers in seconds, and
# skipping on a stamp is what let a failed build leave the worker on stale code until the next
# commit landed.
if cargo build --release --bin seed; then
  echo "$remote_head" > "$STAMP"
  log "Built ${remote_head:0:8}"
  exit 0
fi

if [[ -x "$BINARY" ]]; then
  log "ERROR: build failed at ${remote_head:0:8}; the binary is whatever last built here"
  exit 1
fi

log "ERROR: build failed at ${remote_head:0:8} and there is no previous binary"
exit 1
