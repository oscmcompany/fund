#!/usr/bin/env bash
set -euo pipefail

# --------------------------------------------------------------------------- #
# provision-trainer-vm -- Provision a fund model trainer VM on exe.dev
#
# Run locally: bash tools/provision-trainer-vm --environment <development|production>
#
# The trainer VM runs no persistent services. It bootstraps the devenv
# environment. After provisioning, SSH in and run start-trainer to install
# the training cron job (weekdays 23:00 UTC, post-close Eastern) and the
# per-minute sync cron job.
#
# Secrets reach the VM the same way the application VM's do: provision-common-vm
# writes AWS credentials, and secretspec resolves the rest from Secrets Manager
# under the VM's profile at run time. The trainer needs MASSIVE_BASE_URL and
# MASSIVE_API_KEY now that it fetches its own bars. It needs no Alpaca
# credentials at all -- it has no account to query and no symbol list to build,
# because the grouped endpoint answers by date.
# --------------------------------------------------------------------------- #

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

VM_ROLE="trainer"
PRODUCTION=false
ENVIRONMENT=""

usage() {
  echo "Usage: $(basename "$0") --environment <development|production>"
  echo ""
  echo "Provision an oscm-fund trainer VM on exe.dev."
  echo "After provisioning, run start-trainer to install the training and sync cron jobs."
  echo ""
  echo "Options:"
  echo "  --environment   Required. Either 'development' or 'production'."
  echo "  -h, --help      Show this help message"
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --environment)
      [[ -z "${2:-}" ]] && { echo "Error: --environment requires a value" >&2; usage 1; }
      ENVIRONMENT="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "Error: unknown option '$1'" >&2; usage 1 ;;
  esac
done

case "$ENVIRONMENT" in
  production) PRODUCTION=true ;;
  development) PRODUCTION=false ;;
  "") echo "Error: --environment is required" >&2; usage 1 ;;
  *) echo "Error: --environment must be 'development' or 'production', got '$ENVIRONMENT'" >&2; usage 1 ;;
esac

# shellcheck source=provision-common-vm
source "$SCRIPT_DIR/provision-common-vm"

echo "fund trainer VM provisioning"
echo "============================="

phase_collect
phase_create_vm
phase_bootstrap
phase_reboot

phase_share_vm

# --------------------------------------------------------------------------- #
# Summary
# --------------------------------------------------------------------------- #

step "Setup complete"

echo ""
echo "--- VM Ready ---"
echo "  VM:       $VM_NAME.exe.xyz"
if [[ -n "$VM_EXTRA_TAG" ]]; then
  echo "  Tags:     #${VM_TAG} #${VM_EXTRA_TAG}"
else
  echo "  Tag:      #${VM_TAG}"
fi
echo "  Profile:  $SECRETSPEC_PROFILE"
echo ""
echo "Next steps:"
echo "  ssh $VM_NAME.exe.xyz"
if [[ "$PRODUCTION" == true ]]; then
  echo "  start-trainer                         # install training and sync cron jobs"
  echo "  tail -f /var/log/fund/train-tide-model.log  # follow training log"
else
  echo "  cd ~/fund"
  echo "  devenv tasks run models:tide:train    # run training manually"
fi
echo "-----------------"
echo ""

if confirm "Drop into VM now?"; then
  exec ssh -t "$VM_NAME.exe.xyz" "cd ~/fund && exec \$SHELL -l"
fi
