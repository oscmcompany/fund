#!/usr/bin/env bash
# Creates every view in `tools/duckdb_initialization.sql` against the real buckets and counts its rows.
#
# A view has twice read wrong without saying so: a stale glob returns empty rather than erroring,
# and a view that fails to create reads as a table nobody made. Either is a view that answers
# nothing, so this treats an empty view and a missing one alike.
#
#   AWS_S3_ARCHIVE_BUCKET_NAME=... AWS_S3_RECORDS_BUCKET_NAME=... FUND_PROFILE=production tools/check-views
#
# Exits 0 when every live view reads rows and every dormant one is empty, 3 when any is not, and
# anything else when the check could not be made. The archiver's nightly records which on
# `ArchiveFolded`. `DUCKDB` overrides the binary.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

BROKEN_STATUS=3
DUCKDB="${DUCKDB:-duckdb}"
INITIALIZATION=tools/duckdb_initialization.sql

for variable in AWS_S3_ARCHIVE_BUCKET_NAME AWS_S3_RECORDS_BUCKET_NAME; do
  if [[ -z "${!variable:-}" ]]; then
    echo "Error: ${variable} is not set" >&2
    exit 1
  fi
done

# Read off the script rather than listed here, so a new view is checked the night it is added.
mapfile -t VIEWS < <(sed -nE 's/^CREATE OR REPLACE VIEW ([a-z_]+) AS$/\1/p' "${INITIALIZATION}")
if [[ ${#VIEWS[@]} -eq 0 ]]; then
  echo "Error: found no views in ${INITIALIZATION}" >&2
  exit 1
fi

# Views whose producer does not run in this profile, and so are expected empty. Each is a claim about
# the world rather than about the view, which is why one that starts reading rows fails the check:
# the producer has come back and the line below has to be removed on purpose.
DORMANT=()
case "${FUND_PROFILE:-}" in
  production)
    # No trader has run in production since 2026-07-14, and no researcher ever has.
    DORMANT=(equity_pairs account_snapshots account_activities events journal experiments)
    ;;
esac

# A view's own block of the script, from its `Loading` line to the next one, run alone after the
# connection preamble so an error it raises can only be its own. No count follows: the creation is
# what is being asked about, and a count of a view that failed to create adds an error of its own.
view_alone() {
  local view="$1"
  sed -n '1,/^\.bail off$/p' "${INITIALIZATION}"
  awk -v start=".print 'Loading ${view}...'" '
    $0 == start { inside = 1; print; next }
    inside && /^\.print / { exit }
    inside { print }
  ' "${INITIALIZATION}"
}

# Whether a dormant view that produced no count failed only because its producer has written nothing.
# Any other error -- a schema mismatch, a denied read -- is the view breaking, dormant or not.
empty_because_unwritten() {
  local errors
  errors="$(view_alone "$1" | "${DUCKDB}" -csv -noheader 2>&1 >/dev/null)" || true
  grep -q 'No files found that match the pattern' <<<"${errors}" \
    && ! grep -v 'No files found that match the pattern' <<<"${errors}" | grep -q 'Error'
}

is_dormant() {
  local view="$1" candidate
  for candidate in "${DORMANT[@]}"; do
    [[ "${candidate}" == "${view}" ]] && return 0
  done
  return 1
}

QUERIES="$(cat "${INITIALIZATION}")"
for view in "${VIEWS[@]}"; do
  QUERIES+=$'\n'"SELECT '${view}', count(*) FROM ${view};"
done

# Counts on stdout, one `view,rows` line each; a view that failed to create prints nothing there.
OUTPUT="$(printf '%s\n' "${QUERIES}" | "${DUCKDB}" -csv -noheader 2>/dev/null)" || true
declare -A ROWS=()
while IFS=, read -r view rows; do
  [[ "${rows}" =~ ^[0-9]+$ ]] && ROWS["${view}"]="${rows}"
done < <(grep -E '^[a-z_]+,[0-9]+$' <<<"${OUTPUT}" || true)

broken=0
live=0
dormant=0
unread=0
for view in "${VIEWS[@]}"; do
  rows="${ROWS[${view}]:-}"
  if is_dormant "${view}"; then
    dormant=$((dormant + 1))
    if [[ -n "${rows}" && "${rows}" -gt 0 ]]; then
      echo "${view}: dormant but reads ${rows} rows; remove it from the dormant list"
      broken=$((broken + 1))
    elif [[ -n "${rows}" ]] || empty_because_unwritten "${view}"; then
      echo "${view}: dormant"
    else
      echo "${view}: dormant, and failed for a reason other than its producer writing nothing"
      broken=$((broken + 1))
    fi
    continue
  fi
  live=$((live + 1))
  if [[ -z "${rows}" ]]; then
    echo "${view}: did not create or could not be read"
    broken=$((broken + 1))
    unread=$((unread + 1))
  elif [[ "${rows}" -eq 0 ]]; then
    echo "${view}: reads no rows"
    broken=$((broken + 1))
  else
    echo "${view}: ${rows} rows"
  fi
done

# Every live view unreadable is the check failing to reach S3, not every view breaking at once.
if [[ "${live}" -gt 0 && "${unread}" -eq "${live}" ]]; then
  echo "Error: no live view could be read; the check was not made" >&2
  exit 1
fi
if [[ "${broken}" -gt 0 ]]; then
  echo "${broken} of ${#VIEWS[@]} views are not in the state this profile expects"
  exit "${BROKEN_STATUS}"
fi
echo "All ${live} live views read rows; ${dormant} dormant views are empty"
