#!/usr/bin/env bash
set -euo pipefail

# run-with-secrets -- Run a command under secretspec, forwarding termination signals to it.
#
# Why this exists. `secretspec run` does not forward SIGTERM to the command it launched: it exits
# on the signal and leaves the child orphaned. Measured, not assumed --
#
#   process-compose -> secretspec -> fund
#
# sending SIGTERM to secretspec killed secretspec and left `fund` running with a new parent, having
# never received a signal and never logged a shutdown. Every restart orphaned the trading service,
# and the handler drain `bin/fund` performs on shutdown -- the thing that stops a liquidation from
# being cut in half between two broker orders -- was unreachable code in production.
#
# The fix is a process group. `set -m` puts the child in its own group, so signalling the negative
# process ID reaches every descendant, including the binary `cargo run` exec'd into. This wrapper
# becomes the process process-compose tracks, so its `shutdown.timeout_seconds` now bounds the real
# shutdown rather than the wrapper's own exit.
#
# Usage: tools/run-with-secrets <command> [args...]

if [[ $# -eq 0 ]]; then
  echo "Usage: $(basename "$0") <command> [args...]" >&2
  exit 2
fi

# Job control, so the child leads its own process group.
set -m

secretspec run -- "$@" &
child=$!

# `kill -TERM -$child` signals the group, not just the leader. secretspec is the leader and the
# binary underneath it is what actually needs the signal.
forward() {
  kill -TERM -"$child" 2>/dev/null || true
}
trap forward TERM INT

# Two waits. A trap firing interrupts the first one and it returns immediately, before the child
# has finished shutting down; the second waits for the child to actually exit. Without it this
# wrapper returns while the service is still draining, which is the same orphaning it exists to
# prevent, arriving one step later.
set +e
wait "$child"
status=$?
wait "$child" 2>/dev/null
set -e

exit "$status"
