#!/usr/bin/env bash
set -euo pipefail

# run-archiver -- What the worker does when the nightly schedule wakes it.
#
# Sync, heal whatever the recent sessions are missing, stop. The schedule fires every night including
# weekends, because the heal asks the calendar and the set difference decides what is owed.
#
# Stopping is this script's job. The stall alarm is the backstop for a hang, not the normal way the
# box turns off -- a finished run once sat burning an hour waiting for an idle alarm.

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REGION="${AWS_REGION:-us-east-1}"
PROFILE_FILE=/etc/fund-profile
INHIBIT_FILE=/etc/fund-archiver.inhibit

# The provisioner's inhibit, left behind only by a reconcile that did not finish. Under /var/lib
# rather than beside the operator's file because this script runs as `ubuntu`, and removing a file
# from /etc needs write permission on /etc.
ONE_SHOT_INHIBIT_FILE=/var/lib/fund/inhibit-once

# Shared with `run-researcher`, which exports its logs by the same rules. See the file's header for
# why every line this script emits has to be JSON.
JSON_LOG_TARGET=run-archiver
# shellcheck source=tools/json-log.sh
source "${REPO_ROOT}/tools/json-log.sh"

# True when the one-shot inhibit was there, and the file is gone either way.
consume_a_one_shot_inhibit() {
  [[ -e "$1" ]] || return 1
  rm -f "$1"
}

instance_id() {
  local token
  token="$(curl -sf -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60" || true)"
  curl -sf -H "X-aws-ec2-metadata-token: $token" \
    "http://169.254.169.254/latest/meta-data/instance-id" || true
}

stop_self() {
  local status=$?
  local instance
  instance="$(instance_id)"
  if [[ -z "$instance" ]]; then
    log "ERROR: could not read instance id; leaving the box up for the stall alarm"
    exit "$status"
  fi
  log "Stopping $instance (exit $status)"
  aws ec2 stop-instances --region "$REGION" --instance-ids "$instance" >/dev/null
  exit "$status"
}

# An operator debugging the box starts it by hand, and a boot service that healed and then stopped
# underneath them would make that impossible.
# Redirected into a dated, service-named file because `split_log_file_name` collects only
# `<date>.<service>.log`; the unit's own `archiver.log` carries no date and is invisible to the
# export. The unit still owns that file, which now holds only what systemd writes around this run.
open_the_json_log archiver
trap 'rm -f "$STATUS_FILE"' EXIT

if [[ -e "$INHIBIT_FILE" ]]; then
  log "$INHIBIT_FILE present; not healing and not stopping"
  exit 0
fi

trap stop_self EXIT

# Honoured once and then gone, and the box still stops -- a scheduled start that neither healed nor
# stopped would burn until the stall alarm, which is why this is not the operator's file.
if consume_a_one_shot_inhibit "$ONE_SHOT_INHIBIT_FILE"; then
  log "$ONE_SHOT_INHIBIT_FILE was present; an unfinished reconcile left it, so skipping the heal"
  exit 0
fi

if [[ ! -r "$PROFILE_FILE" ]]; then
  log "ERROR: $PROFILE_FILE is missing; it names the profile whose keys this box may read"
  exit 1
fi
FUND_PROFILE="$(cat "$PROFILE_FILE")"
export FUND_PROFILE

# The legacy journal, which nothing writes since the fold stopped; `export-records` still ships it and this
# script's logs, the only way anything this box learns survives the power-off at the end of this script.
FUND_JOURNAL_DIRECTORY=/var/journal/fund
export FUND_JOURNAL_DIRECTORY
mkdir -p "$FUND_JOURNAL_DIRECTORY"

cd "$REPO_ROOT"

# The legacy fold stopped at archive task A6's cutover; the checkout is still synced for this script and the export.
log "Syncing"
SYNC_STATUS=0
run_wrapped sync-archiver tools/sync-archiver || SYNC_STATUS=$?

# The archiver: independent of the legacy sync, and never in the way of the export below, since its own records ship
# from inside the binary.
NEW_ARCHIVER_STATUS=0
VIEWS_STATUS=0
log "Running the rebuilt archiver"
# Bounded so a hang cannot hold the export: the build well under the stall alarm's idle hour, the heal past its own
# 240-minute budget, which it checks only between sessions.
if run_wrapped sync-new-archiver timeout 1800 tools/sync-new-archiver; then
  run_wrapped archive-nightly timeout 18000 tools/run-backfill heal-archive || NEW_ARCHIVER_STATUS=$?
  run_wrapped archive-views-check timeout 600 tools/run-backfill check-archive-views || VIEWS_STATUS=$?
else
  NEW_ARCHIVER_STATUS=1
fi
log "Rebuilt archiver finished with status ${NEW_ARCHIVER_STATUS}, its views with ${VIEWS_STATUS}"

# Before the trap stops the box, which is the whole point: an export that raced the shutdown would
# collect nothing and leave the night on a machine that is off.
EXPORT_STATUS=0
log "Exporting records"
run_wrapped seed-export tools/run-backfill export-records || EXPORT_STATUS=$?
if [[ "$EXPORT_STATUS" -eq 0 ]]; then
  log "Records exported"
else
  log "ERROR: records failed to export with status ${EXPORT_STATUS}; they remain on this box only"
fi

# Any stage. A night whose records never left the box is the one failure a box that powers itself off cannot recover
# from, so the export counts as much as the heal.
exit "$(first_failure "$SYNC_STATUS" "$NEW_ARCHIVER_STATUS" "$VIEWS_STATUS" "$EXPORT_STATUS")"
