#!/usr/bin/env bash
set -euo pipefail

# --------------------------------------------------------------------------- #
# provision-archive-worker -- Reconcile the EC2 instance that writes the archive
#
# Run locally: bash tools/provision-archive-worker --profile <profile> [--apply]
#
# Every resource is ensured rather than created, on `create-bucket`'s shape, so a second run is a
# no-op and a field that drifted is corrected. It is the replacement for the hand-rolled
# `fund-quote-backfill` box, which carried four long passes and was recorded nowhere.
#
# The IAM policy is derived from the profile rather than read from a file beside this one. The
# records bucket and the secretspec prefix are both functions of the profile, and the file this
# replaced had already drifted from the live role -- Git said `development/john.forstmeier/*` while
# the role allowed all of `secretspec/fund/*`.
# --------------------------------------------------------------------------- #

REGION="${AWS_REGION:-us-east-1}"
NAME="fund-archive-worker"
INSTANCE_TYPE="r6i.2xlarge"
VOLUME_SIZE_GB=100

# 03:00 Eastern in summer, 02:00 in winter, folding the session that closed the previous Eastern
# day. `seed` re-asks `TradingCalendar` on waking, so this fires every night and the code decides
# whether there is a session to write. tests/test_schedules.rs pins this literal.
SCHEDULE_EXPRESSION="cron(0 7 * * ? *)"

# The worker has no nightly fold verb yet -- `archive-cadence` reads and writes nothing, and the
# writer is task 10. Until that lands the trigger is recorded but off.
SCHEDULE_STATE="DISABLED"

# Idle for an hour with the fetch dead. The backstop for a hang, never the normal way the box stops
# -- `run-archive-worker` stops itself, and an idle alarm left a finished run burning an hour once.
STALL_PERIOD_SECONDS=300
STALL_EVALUATION_PERIODS=12
STALL_THRESHOLD_BYTES=1000000

PROFILE=""
APPLY=false

usage() {
  echo "Usage: $(basename "$0") --profile <profile> [--apply]"
  echo ""
  echo "Reconcile the archive worker: IAM role, instance profile, security group,"
  echo "instance, stall alarm, and the nightly schedule that starts it."
  echo ""
  echo "Options:"
  echo "  --profile   Required. production or development/<name>."
  echo "  --apply     Make changes. Without it, report what would change and exit."
  echo "  -h, --help  Show this help message"
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      [[ -z "${2:-}" ]] && { echo "Error: --profile requires a value" >&2; usage 1; }
      PROFILE="$2"; shift 2 ;;
    --apply) APPLY=true; shift ;;
    -h|--help) usage ;;
    *) echo "Error: unknown option '$1'" >&2; usage 1 ;;
  esac
done

# The shape `create-bucket` and `run-backfill` accept, and for the same reason: the records bucket is
# derived from this string, so `archive` would resolve records to the shared archive bucket.
if [[ ! "$PROFILE" =~ ^(production|development/[a-z0-9][a-z0-9.-]*)$ ]]; then
  echo "Error: --profile must be production or development/<name>; got \"$PROFILE\"." >&2
  exit 1
fi

SLUG="${PROFILE//[\/.]/-}"
RECORDS_BUCKET="oscm-fund-${SLUG}"
ARCHIVE_BUCKET="oscm-fund-archive"
ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"

step() {
  echo ""
  echo "==> $1"
}

changed() {
  if [[ "$APPLY" == true ]]; then
    echo "    CHANGED: $1"
  else
    echo "    WOULD CHANGE: $1"
  fi
}

unchanged() {
  echo "    ok: $1"
}

if [[ "$APPLY" != true ]]; then
  echo "DRY RUN -- pass --apply to make changes"
fi
echo "Profile:  $PROFILE"
echo "Records:  $RECORDS_BUCKET"
echo "Region:   $REGION"

# --------------------------------------------------------------------------- #
# IAM role and inline policy
# --------------------------------------------------------------------------- #

step "IAM role $NAME"

TRUST_POLICY='{"Version":"2012-10-17","Statement":[{"Effect":"Allow",
"Principal":{"Service":"ec2.amazonaws.com"},"Action":"sts:AssumeRole"}]}'

ROLE_POLICY="$(cat <<JSON
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArchiveObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket", "s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::${RECORDS_BUCKET}",
        "arn:aws:s3:::${RECORDS_BUCKET}/*",
        "arn:aws:s3:::${ARCHIVE_BUCKET}",
        "arn:aws:s3:::${ARCHIVE_BUCKET}/*"
      ]
    },
    {
      "Sid": "ReadOwnSecretspecKeys",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:${REGION}:${ACCOUNT_ID}:secret:secretspec/fund/${PROFILE}/*"
    },
    {
      "Sid": "StopSelfWhenDone",
      "Effect": "Allow",
      "Action": ["ec2:StopInstances"],
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/*",
      "Condition": {"StringEquals": {"ec2:ResourceTag/fund-role": "archive-worker"}}
    }
  ]
}
JSON
)"

if aws iam get-role --role-name "$NAME" >/dev/null 2>&1; then
  unchanged "role exists"
else
  changed "create role"
  if [[ "$APPLY" == true ]]; then
    aws iam create-role --role-name "$NAME" \
      --assume-role-policy-document "$TRUST_POLICY" >/dev/null
  fi
fi

# Always written. This is the reconciliation that closes the drift the file-based policy allowed.
changed "put inline policy archive-and-secrets"
if [[ "$APPLY" == true ]]; then
  aws iam put-role-policy --role-name "$NAME" \
    --policy-name archive-and-secrets --policy-document "$ROLE_POLICY"
  aws iam attach-role-policy --role-name "$NAME" \
    --policy-arn arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore
fi

step "Instance profile $NAME"

if aws iam get-instance-profile --instance-profile-name "$NAME" >/dev/null 2>&1; then
  unchanged "instance profile exists"
else
  changed "create instance profile"
  if [[ "$APPLY" == true ]]; then
    aws iam create-instance-profile --instance-profile-name "$NAME" >/dev/null
    aws iam add-role-to-instance-profile \
      --instance-profile-name "$NAME" --role-name "$NAME"
    # The profile is not usable the instant it is created; an immediate RunInstances gets
    # InvalidParameterValue on the ARN.
    aws iam wait instance-profile-exists --instance-profile-name "$NAME"
  fi
fi

# --------------------------------------------------------------------------- #
# Network
# --------------------------------------------------------------------------- #

step "Security group $NAME"

VPC_ID="$(aws ec2 describe-vpcs --region "$REGION" \
  --filters Name=is-default,Values=true --query 'Vpcs[0].VpcId' --output text)"
if [[ "$VPC_ID" == "None" || -z "$VPC_ID" ]]; then
  echo "Error: no default VPC in $REGION; the worker needs a subnet with outbound access." >&2
  exit 1
fi

SECURITY_GROUP_ID="$(aws ec2 describe-security-groups --region "$REGION" \
  --filters "Name=group-name,Values=$NAME" "Name=vpc-id,Values=$VPC_ID" \
  --query 'SecurityGroups[0].GroupId' --output text 2>/dev/null || echo None)"

if [[ "$SECURITY_GROUP_ID" != "None" && -n "$SECURITY_GROUP_ID" ]]; then
  unchanged "security group $SECURITY_GROUP_ID"
else
  changed "create security group (no ingress; SSM reaches it outbound)"
  if [[ "$APPLY" == true ]]; then
    SECURITY_GROUP_ID="$(aws ec2 create-security-group --region "$REGION" \
      --group-name "$NAME" --vpc-id "$VPC_ID" \
      --description "Archive worker: outbound only, reached via SSM" \
      --query GroupId --output text)"
  fi
fi

# --------------------------------------------------------------------------- #
# Instance
# --------------------------------------------------------------------------- #

step "Instance $NAME"

INSTANCE_ID="$(aws ec2 describe-instances --region "$REGION" \
  --filters "Name=tag:fund-role,Values=archive-worker" \
    "Name=instance-state-name,Values=pending,running,stopping,stopped" \
  --query 'Reservations[0].Instances[0].InstanceId' --output text 2>/dev/null || echo None)"

if [[ "$INSTANCE_ID" != "None" && -n "$INSTANCE_ID" ]]; then
  unchanged "instance $INSTANCE_ID"
else
  # Resolved rather than pinned so a first provision gets current security updates; the resolved id
  # is tagged onto the instance so what is running stays auditable.
  AMI_ID="$(aws ssm get-parameter --region "$REGION" \
    --name /aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id \
    --query 'Parameter.Value' --output text)"
  changed "run instance $INSTANCE_TYPE from $AMI_ID"
  if [[ "$APPLY" == true ]]; then
    INSTANCE_ID="$(aws ec2 run-instances --region "$REGION" \
      --image-id "$AMI_ID" --instance-type "$INSTANCE_TYPE" \
      --iam-instance-profile "Name=$NAME" \
      --security-group-ids "$SECURITY_GROUP_ID" \
      --block-device-mappings "DeviceName=/dev/sda1,Ebs={VolumeSize=$VOLUME_SIZE_GB,VolumeType=gp3}" \
      --metadata-options "HttpTokens=required" \
      --tag-specifications "ResourceType=instance,Tags=[\
{Key=Name,Value=$NAME},{Key=fund-role,Value=archive-worker},\
{Key=fund-profile,Value=$PROFILE},{Key=fund-ami,Value=$AMI_ID}]" \
      --query 'Instances[0].InstanceId' --output text)"
    aws ec2 wait instance-running --region "$REGION" --instance-ids "$INSTANCE_ID"
    echo "    instance $INSTANCE_ID running; bootstrap it with tools/sync-archive-worker"
  fi
fi

# --------------------------------------------------------------------------- #
# Stall alarm and nightly schedule
# --------------------------------------------------------------------------- #

step "Stall alarm $NAME-stalled"

if [[ "$APPLY" == true && "$INSTANCE_ID" != "None" ]]; then
  aws cloudwatch put-metric-alarm --region "$REGION" \
    --alarm-name "$NAME-stalled" \
    --alarm-description "Stop the archive worker when its fetch has been dead for an hour" \
    --namespace AWS/EC2 --metric-name NetworkIn --statistic Sum \
    --dimensions "Name=InstanceId,Value=$INSTANCE_ID" \
    --period "$STALL_PERIOD_SECONDS" --evaluation-periods "$STALL_EVALUATION_PERIODS" \
    --threshold "$STALL_THRESHOLD_BYTES" --comparison-operator LessThanThreshold \
    --treat-missing-data notBreaching \
    --alarm-actions "arn:aws:automate:${REGION}:ec2:stop"
  changed "alarm bound to $INSTANCE_ID"
else
  changed "put alarm"
fi

step "Nightly schedule $NAME-nightly"

SCHEDULER_ROLE="${NAME}-scheduler"
SCHEDULER_TRUST='{"Version":"2012-10-17","Statement":[{"Effect":"Allow",
"Principal":{"Service":"scheduler.amazonaws.com"},"Action":"sts:AssumeRole"}]}'

if aws iam get-role --role-name "$SCHEDULER_ROLE" >/dev/null 2>&1; then
  unchanged "scheduler role exists"
else
  changed "create scheduler role"
  if [[ "$APPLY" == true ]]; then
    aws iam create-role --role-name "$SCHEDULER_ROLE" \
      --assume-role-policy-document "$SCHEDULER_TRUST" >/dev/null
    aws iam wait role-exists --role-name "$SCHEDULER_ROLE"
  fi
fi

if [[ "$APPLY" == true && ( -z "$INSTANCE_ID" || "$INSTANCE_ID" == "None" ) ]]; then
  echo "Error: no instance to target; the schedule would start nothing." >&2
  exit 1
fi

if [[ "$APPLY" == true ]]; then
  aws iam put-role-policy --role-name "$SCHEDULER_ROLE" --policy-name start-archive-worker \
    --policy-document "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",
\"Action\":[\"ec2:StartInstances\"],\"Resource\":\"*\",
\"Condition\":{\"StringEquals\":{\"ec2:ResourceTag/fund-role\":\"archive-worker\"}}}]}"

  SCHEDULE_TARGET="{\"Arn\":\"arn:aws:scheduler:::aws-sdk:ec2:startInstances\",
\"RoleArn\":\"arn:aws:iam::${ACCOUNT_ID}:role/${SCHEDULER_ROLE}\",
\"Input\":\"{\\\"InstanceIds\\\":[\\\"${INSTANCE_ID}\\\"]}\"}"

  # DISABLED until task 10 lands the nightly fold verb and the boot service that calls it. Creating
  # it now records the trigger in Git and keeps the enable to one flag; starting a box every night
  # to run nothing would just be a nightly bill.
  if aws scheduler get-schedule --region "$REGION" --name "$NAME-nightly" >/dev/null 2>&1; then
    aws scheduler update-schedule --region "$REGION" --name "$NAME-nightly" --state "$SCHEDULE_STATE" \
      --schedule-expression "$SCHEDULE_EXPRESSION" --schedule-expression-timezone UTC \
      --flexible-time-window '{"Mode":"OFF"}' --target "$SCHEDULE_TARGET" >/dev/null
    changed "schedule updated to $SCHEDULE_EXPRESSION ($SCHEDULE_STATE)"
  else
    aws scheduler create-schedule --region "$REGION" --name "$NAME-nightly" --state "$SCHEDULE_STATE" \
      --schedule-expression "$SCHEDULE_EXPRESSION" --schedule-expression-timezone UTC \
      --flexible-time-window '{"Mode":"OFF"}' --target "$SCHEDULE_TARGET" >/dev/null
    changed "schedule created at $SCHEDULE_EXPRESSION ($SCHEDULE_STATE)"
  fi
else
  changed "ensure schedule at $SCHEDULE_EXPRESSION ($SCHEDULE_STATE)"
fi

step "Done"
echo ""
echo "  Instance: ${INSTANCE_ID}"
echo "  Schedule: ${SCHEDULE_EXPRESSION} UTC, gated in seed on the Eastern calendar"
echo ""
if [[ "$APPLY" != true ]]; then
  echo "  Dry run. Re-run with --apply to make these changes."
fi
