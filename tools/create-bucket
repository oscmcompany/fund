#!/usr/bin/env bash
set -euo pipefail

PROFILE="${1:-}"
if [[ -z "$PROFILE" ]]; then
  echo "Usage: $(basename "$0") <profile>"
  echo "  e.g. $(basename "$0") development/chris.addy"
  echo "  e.g. $(basename "$0") production"
  exit 1
fi

SLUG="${PROFILE//[\/.]/-}"
BUCKET="oscm-fund-${SLUG}"

echo "Ensuring bucket $BUCKET exists"
if output=$(aws s3api create-bucket --bucket "$BUCKET" --region us-east-1 2>&1); then
  echo "Created bucket $BUCKET"
elif echo "$output" | grep -q "BucketAlreadyOwnedByYou"; then
  echo "Bucket $BUCKET already exists, skipping"
else
  echo "Error creating bucket $BUCKET: $output" >&2
  exit 1
fi

# Every nightly export writes a date-partitioned key, so no export object is ever overwritten and
# versioning costs nothing for them. It exists for the two keys that *are* written in place: the
# capital flow ledger, which is kept out of the public repository and so has no git history to fall
# back on, and database/backups/fund-latest.dump.gz, where today a truncated dump silently replaces
# the only good one.
#
# Deliberately no lifecycle expiration. The same-key writes are infrequent, and versioning cannot be
# disabled once enabled -- only suspended -- so rules are easier to add later than to take back.
echo "Enabling versioning on $BUCKET"
aws s3api put-bucket-versioning --bucket "$BUCKET" \
  --versioning-configuration Status=Enabled

echo "S3 bucket ready: $BUCKET"
