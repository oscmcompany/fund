#!/usr/bin/env bash
set -euo pipefail

PROFILE="${1:-}"
if [[ -z "$PROFILE" ]]; then
  echo "Usage: $(basename "$0") <profile>"
  echo "  e.g. $(basename "$0") development/chris.addy"
  echo "  e.g. $(basename "$0") production"
  exit 1
fi

# This script makes one records bucket per profile and nothing else. The name is derived from the
# argument, so a non-profile still produces a plausible bucket: `archive` would reach
# `oscm-fund-archive` and enable versioning on a corpus that repairs partitions in place, and bare
# `development` -- secretspec's credential-less fallback, which `provision-common-vm` refuses as a
# deployment target -- would make a bucket no VM is provisioned against. Versioning cannot be
# turned back off once enabled, only suspended, so the shape is validated instead.
if [[ ! "$PROFILE" =~ ^(production|development/[a-z0-9][a-z0-9.-]*)$ ]]; then
  echo "Error: \"$PROFILE\" is not a profile." >&2
  echo "" >&2
  echo "  Profiles are: production or development/<name>." >&2
  echo "" >&2
  echo "  This creates the per-instance records bucket that holds exports/, models/ and" >&2
  echo "  database/. The shared archive holding data/** is not a profile and is not made" >&2
  echo "  here -- it is a single hand-configured fixture, deliberately without versioning." >&2
  exit 1
fi

SLUG="${PROFILE//[\/.]/-}"
BUCKET="oscm-fund-${SLUG}"

echo "Ensuring bucket $BUCKET exists"
if output=$(aws s3api create-bucket --bucket "$BUCKET" --region us-east-1 2>&1); then
  echo "Created bucket $BUCKET"
elif echo "$output" | grep -q "BucketAlreadyOwnedByYou"; then
  echo "Bucket $BUCKET already exists, skipping"
else
  echo "Error creating bucket $BUCKET: $output" >&2
  exit 1
fi

# For the two keys written in place: the gitignored capital flow ledger, and
# database/backups/fund-latest.dump.gz, where a truncated dump would otherwise replace the only good
# one. Nightly exports write date-partitioned keys and accumulate no versions.
#
# No lifecycle expiration by decision -- versioning cannot be disabled once enabled, only suspended,
# so rules are easier to add later than to take back.
echo "Enabling versioning on $BUCKET"
aws s3api put-bucket-versioning --bucket "$BUCKET" \
  --versioning-configuration Status=Enabled

echo "S3 bucket ready: $BUCKET"
