#!/usr/bin/env bash
# Runs `seed` on a bare backfill box, where there is no devenv shell to inherit an environment from.
#
# devenv's runtimeEnv normally supplies FUND_PROFILE, the two bucket names and the log directory, but
# a provisioned EC2 box has none of it and `seed` reads its configuration from the environment alone.
# This assembles the same environment from Secrets Manager and execs `seed` with its arguments.
#
#   run-backfill equity-trades archive --start 2021-08-26 --end 2026-08-28 --source vendor-keeping-raw
#
# The instance role this runs under is reconciled by `provision-archiver` beside this file,
# which derives the policy from the profile rather than reading a fixed document:
#   bash tools/provision-archiver --profile development/<name> --apply
set -euo pipefail

REGION="${AWS_REGION:-us-east-1}"
PROFILE="${FUND_PROFILE:-}"

# The shape `create-bucket` accepts, and for its reason: the records bucket is derived from this
# string, so an argument like `archive` would resolve records to the shared archive bucket.
if [[ ! "$PROFILE" =~ ^(production|development/[a-z0-9][a-z0-9.-]*)$ ]]; then
  echo "Error: FUND_PROFILE must be production or development/<name>; got \"$PROFILE\"." >&2
  echo "  It names both the secretspec profile and this instance's records bucket." >&2
  exit 1
fi

# Assigned rather than defaulted. This role can reach both buckets, so honouring a caller's
# AWS_S3_RECORDS_BUCKET_NAME would let one instance's records be written into the shared archive.
SLUG="${PROFILE//[\/.]/-}"
export AWS_S3_RECORDS_BUCKET_NAME="oscm-fund-${SLUG}"
# devenv.nix holds the same literal as `archiveBucket` and is the source of truth; nix values are
# not readable from bash, which is why it appears twice.
export AWS_S3_ARCHIVE_BUCKET_NAME="oscm-fund-archive"

# Read individually rather than through secretspec, which is not installed on a provisioned box. The
# two lists mirror secretspec.toml, so this reproduces its contract instead of a stricter one.
REQUIRED_KEYS="MASSIVE_BASE_URL MASSIVE_API_KEY ALPACA_API_KEY_ID ALPACA_API_SECRET"
OPTIONAL_KEYS="MASSIVE_S3_ENDPOINT MASSIVE_S3_ACCESS_KEY_ID MASSIVE_S3_SECRET_ACCESS_KEY ALPACA_IS_PAPER SEC_EDGAR_CONTACT_EMAIL"

# Subcommands that reach no provider. Loading market-data credentials for them would make a Massive
# or Alpaca outage stop the very command that ships the diagnostics explaining it -- the export runs
# after a failed night, which is exactly when a credential problem is likely to be the cause.
case "${1:-}" in
  export-records | check-views | check-archive-views)
    REQUIRED_KEYS=""
    OPTIONAL_KEYS=""
    ;;
  # The rebuilt archiver reads only the vendors' keys; it ships its own journal and logs.
  heal-archive)
    OPTIONAL_KEYS="ALPACA_IS_PAPER"
    ;;
  # The drift checks come through here for this environment alone. Keys per tool: the
  # classification check reads a public feed, and loading Massive's credential for it would let a
  # missing Massive secret record a failed check the tool never needed that secret for.
  check-reference)
    case "${2:-}" in
      fetch-trade-conditions) REQUIRED_KEYS="MASSIVE_BASE_URL MASSIVE_API_KEY" ;;
      *) REQUIRED_KEYS="" ;;
    esac
    OPTIONAL_KEYS=""
    ;;
esac

STDERR_FILE="$(mktemp)"
trap 'rm -f "$STDERR_FILE"' EXIT

read_secret() {
  local key="$1" requirement="$2" value
  # stderr to a file rather than 2>&1, which would fold a warning on a successful call into the value.
  if value="$(aws secretsmanager get-secret-value --region "$REGION" \
    --secret-id "secretspec/fund/$PROFILE/$key" --query SecretString --output text 2>"$STDERR_FILE")"; then
    export "$key"="$value"
    return 0
  fi
  # Absence alone is tolerated: a denial or a network failure must not read as an unset optional key,
  # which is how a missing grant would become a silent misconfiguration rather than a startup error.
  if [[ "$requirement" == optional ]] && grep -q ResourceNotFoundException "$STDERR_FILE"; then
    return 0
  fi
  echo "Error: could not read secretspec/fund/$PROFILE/$key" >&2
  cat "$STDERR_FILE" >&2
  exit 1
}

for key in $REQUIRED_KEYS; do read_secret "$key" required; done
for key in $OPTIONAL_KEYS; do read_secret "$key" optional; done

export FUND_PROFILE="$PROFILE"
export AWS_REGION="$REGION"
# No database on a backfill box, so the `query!` macros must resolve against the checked-in cache.
export SQLX_OFFLINE=true
export RUST_LOG="${RUST_LOG:-info}"

# An SSM session leaves HOME unset, and `set -u` turns that into a crash rather than a message.
ROOT="${FUND_ROOT:-${HOME:+$HOME/fund}}"
if [[ -z "$ROOT" ]]; then
  echo "Error: set FUND_ROOT to the checkout; HOME is unset, so it cannot be derived." >&2
  exit 1
fi

cd "$ROOT"
rm -f "$STDERR_FILE"

# Named tools only, so this cannot become a way to run anything in the checkout with the box's
# credentials. The exit status is the tool's own, which `run-archiver` hands to the nightly.
if [[ "${1:-}" == "check-reference" ]]; then
  case "${2:-}" in
    fetch-trade-conditions | fetch-industry-classifications) ;;
    *)
      echo "Error: check-reference takes fetch-trade-conditions or fetch-industry-classifications." >&2
      exit 2
      ;;
  esac
  # The classification check formats with rustfmt, which rustup installs where a service's PATH
  # does not look.
  if [[ -d "${HOME:-}/.cargo/bin" ]]; then
    export PATH="$HOME/.cargo/bin:$PATH"
  fi
  exec "tools/$2" --check
fi

if [[ "${1:-}" == "check-views" ]]; then
  exec tools/check-views
fi

# The rebuilt archiver from the master checkout `sync-new-archiver` keeps, with directories of its own so the legacy
# export never reads its files. Derived here only, so the commands above never need HOME.
if [[ "${1:-}" == "heal-archive" || "${1:-}" == "check-archive-views" ]]; then
  NEW_ROOT="${FUND_NEW_ROOT:-${HOME:+$HOME/fund-master}}"
  if [[ -z "$NEW_ROOT" ]]; then
    echo "Error: set FUND_NEW_ROOT to the master checkout; HOME is unset, so it cannot be derived." >&2
    exit 1
  fi
fi

if [[ "${1:-}" == "heal-archive" ]]; then
  # The default secretspec.toml declares for each profile, so a development box never reaches live Alpaca.
  case "$PROFILE" in
    production) export ALPACA_IS_PAPER="${ALPACA_IS_PAPER:-false}" ;;
    *) export ALPACA_IS_PAPER="${ALPACA_IS_PAPER:-true}" ;;
  esac
  export FUND_JOURNAL_DIRECTORY="$NEW_ROOT-records/journal"
  export FUND_LOG_DIRECTORY="$NEW_ROOT-records/logs"
  exec "$NEW_ROOT/target/release/archive_nightly"
fi

if [[ "${1:-}" == "check-archive-views" ]]; then
  exec "$NEW_ROOT/check-views"
fi

exec ./target/release/seed "$@"
