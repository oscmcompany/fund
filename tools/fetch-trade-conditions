#!/usr/bin/env bash
# Publishes the provider's sale-condition table to the archive as an `as_of`-partitioned dataset.
#
# The table decides which trades enter volume, VWAP and the effective spread. It used to be baked
# into `src/data/conditions_table.rs`, so moving one row meant regenerating Rust, committing it and
# deploying a binary; it is now data, and `seed` loads the newest partition at the start of a trades
# leg and journals the `as_of` it ran under.
#
#   secretspec run -- tools/fetch-trade-conditions
#   secretspec run -- tools/fetch-trade-conditions --check
#
# `--check` publishes nothing and exits non-zero when the provider has moved, which is the drift
# detection a published table would otherwise lack. Deliberately not a test: it needs the network
# and a credential, and a suite that fails when the vendor is down stops meaning anything.
#
# The fold cannot be undone, so republishing does not change a partition already written -- unlike
# the classification mapping, which is applied on every read. What a new `as_of` changes is every
# fold after it, which is why the run that used one records which.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

CHECK_ONLY=false
if [[ "${1:-}" == "--check" ]]; then
  CHECK_ONLY=true
elif [[ -n "${1:-}" ]]; then
  echo "Usage: $(basename "$0") [--check]" >&2
  exit 1
fi

for variable in MASSIVE_BASE_URL MASSIVE_API_KEY; do
  if [[ -z "${!variable:-}" ]]; then
    echo "Error: ${variable} is not set; run under 'secretspec run --'" >&2
    exit 1
  fi
done

if [[ "${MASSIVE_BASE_URL}" != https://* ]]; then
  echo "Error: MASSIVE_BASE_URL is not https, so the credential would cross the wire in clear" >&2
  exit 1
fi

WORK="$(mktemp -d)"
trap 'rm -rf "${WORK}"' EXIT
RESPONSE="${WORK}/response.json"
CONDITIONS_CSV="${WORK}/conditions.csv"
CONDITIONS_PARQUET="${WORK}/conditions.parquet"

echo "Fetching sale conditions from ${MASSIVE_BASE_URL}"
# The key travels as a bearer header fed over stdin, so it reaches neither the query string nor
# `argv`. The header half matches `massive.rs:311` and the reason recorded there — reqwest prints the
# full URL when a decode fails, so a key in the URL reaches every log line reporting one. The stdin
# half is this script's own: an argument would sit in `ps` output for as long as the request runs,
# and a config file would put the credential on disk.
curl -sS --fail-with-body --config - -o "${RESPONSE}" <<CURL_CONFIGURATION
url = "${MASSIVE_BASE_URL}/v3/reference/conditions?asset_class=stocks&limit=1000"
header = "Authorization: Bearer ${MASSIVE_API_KEY}"
CURL_CONFIGURATION

python3 - "${RESPONSE}" "${CONDITIONS_CSV}" <<'PYTHON'
import csv
import json
import sys

response, output = sys.argv[1], sys.argv[2]
with open(response) as handle:
    payload = json.load(handle)

conditions = sorted(
    (row for row in payload.get("results", []) if row.get("type") == "sale_condition"),
    key=lambda row: row["id"],
)
if not conditions:
    sys.exit("Error: the response carried no sale conditions")

for row in conditions:
    rules = row.get("update_rules", {}).get("consolidated", {})
    for rule in ("updates_volume", "updates_high_low", "updates_open_close"):
        if rule not in rules:
            sys.exit(f"Error: condition {row['id']} is missing {rule}")


def character(row, tape):
    value = row.get("sip_mapping", {}).get(tape)
    if value is None:
        return ""
    # Bytes, not code points: the loader reads the stored string as one byte, so a two-byte
    # character passes a `len()` check here and is refused at 07:00Z instead of at this desk.
    if len(value.encode("utf-8")) != 1:
        sys.exit(f"Error: condition {row['id']} maps to {value!r} on {tape}, which is not one byte")
    return value


# `lineterminator` because csv.writer defaults to CRLF, and the trailing carriage return reaches
# every downstream comparison as part of the value.
with open(output, "w", newline="") as handle:
    writer = csv.writer(handle, lineterminator="\n")
    writer.writerow(
        [
            "identifier",
            "name",
            "updates_volume",
            "updates_high_low",
            "updates_open_close",
            "consolidated_tape_association",
            "unlisted_trading_privileges",
            "trade_data_dissemination",
        ]
    )
    for row in conditions:
        rules = row["update_rules"]["consolidated"]
        writer.writerow(
            [
                row["id"],
                row["name"],
                str(rules["updates_volume"]).lower(),
                str(rules["updates_high_low"]).lower(),
                str(rules["updates_open_close"]).lower(),
                character(row, "CTA"),
                character(row, "UTP"),
                character(row, "FINRA_TDDS"),
            ]
        )

print(f"Read {len(conditions)} sale conditions")
PYTHON

# duckdb rather than a Rust helper, because nothing in the binary should be able to write this: the
# archive reads it, and a writer in the same process is a way for a run to quietly re-decide which
# prints it was measuring.
echo "Encoding the conditions"
duckdb -c "COPY (SELECT CAST(identifier AS UINTEGER) AS identifier, name, \
  CAST(updates_volume AS BOOLEAN) AS updates_volume, \
  CAST(updates_high_low AS BOOLEAN) AS updates_high_low, \
  CAST(updates_open_close AS BOOLEAN) AS updates_open_close, \
  consolidated_tape_association, unlisted_trading_privileges, trade_data_dissemination \
  FROM read_csv('${CONDITIONS_CSV}', header = true, all_varchar = true)) \
  TO '${CONDITIONS_PARQUET}' (FORMAT parquet);"

# The five rows the archive's own numbers depend on, checked here as well as at load time. A loader
# refusing them takes the fold down tonight; this says so while someone is watching, and names the
# row rather than leaving the operator to read a stack trace at 07:00Z.
echo "Checking the rows the archive cannot be wrong about"
ANCHORS_FAILED=false
check_anchor() {
  local identifier="$1" name="$2" volume="$3"
  local found
  found="$(duckdb -noheader -list -c "SELECT name || '|' || updates_volume FROM \
    read_parquet('${CONDITIONS_PARQUET}') WHERE identifier = ${identifier};")"
  if [[ -z "${found}" ]]; then
    echo "    ${identifier}: MISSING, expected \"${name}\"" >&2
    ANCHORS_FAILED=true
  elif [[ "${found}" != "${name}|${volume}" ]]; then
    echo "    ${identifier}: \"${found}\", expected \"${name}|${volume}\"" >&2
    ANCHORS_FAILED=true
  fi
}
# The house rule's two, which are ours, and the three auction prints the volume rule exists to
# exclude -- 14.1% of a session's dollar volume, measured 2026-08-21.
check_anchor 2 "Average Price Trade" true
check_anchor 10 "Derivatively Priced" true
check_anchor 15 "Market Center Official Close" false
check_anchor 16 "Market Center Official Open" false
check_anchor 38 "Corrected Consolidated Close (per listing market)" false
if [[ "${ANCHORS_FAILED}" == true ]]; then
  echo "Error: the provider has moved a row the archive's rules are written against." >&2
  echo "  Publishing it would make every loader refuse the table. Update ANCHORS in" >&2
  echo "  src/data/conditions.rs deliberately, deploy it, then re-run to publish." >&2
  exit 1
fi
echo "    all five still say what the archive believes"

BUCKET="${AWS_S3_ARCHIVE_BUCKET_NAME:-oscm-fund-archive}"
PREFIX="data/reference/conditions"

# Fail closed. A masked error here -- expired credentials, a denied listing -- would read as an empty
# prefix, and the script would answer "nothing stored yet" and publish over whatever is actually
# there. Every key is listed and the maximum taken in the shell rather than by JMESPath, because
# `--query` with `--output text` is applied per page and a paginated listing would leave several keys
# in one variable.
ALL_KEYS="$(aws s3api list-objects-v2 --bucket "${BUCKET}" --prefix "${PREFIX}/" \
  --query 'Contents[].Key' --output text)"
# Only keys of the exact shape the loader reads. `conditions_as_of_dates` keeps a key only when it
# round-trips to `as_of=<date>/data.parquet`, so a nested `as_of=.../backup/data.parquet` would make
# this script answer "unchanged" while the loader kept folding under an older partition -- the two
# disagreeing about whether anything is wrong.
# `|| NEWEST_KEY=""` because an empty prefix makes `grep` match nothing, and `pipefail` turns that
# into a fatal error on the one run that most needs to succeed -- the first publish. The fail-closed
# property is untouched: the listing itself is a separate assignment and still aborts the script.
NEWEST_KEY="$(printf '%s' "${ALL_KEYS}" | tr '\t' '\n' \
  | grep -E "^${PREFIX}/as_of=[0-9]{4}-[0-9]{2}-[0-9]{2}/data\.parquet$" | sort | tail -1)" \
  || NEWEST_KEY=""
[[ -z "${NEWEST_KEY}" ]] && NEWEST_KEY="None"

UNCHANGED=false
if [[ "${NEWEST_KEY}" != "None" ]]; then
  aws s3 cp "s3://${BUCKET}/${NEWEST_KEY}" "${WORK}/stored.parquet" --quiet
  # Compared as a set of rows, not as bytes: parquet encoding is not reproducible, so a byte diff
  # would report drift on every run and stop meaning anything.
  # EXCEPT ALL, not EXCEPT: set semantics would call a stored object holding a duplicated identifier
  # identical to a clean one, so this would refuse to republish while the loader refuses to read it
  # as duplicated -- the two disagreeing about whether anything is wrong.
  DIFFERENCES="$(duckdb -noheader -list -c "SELECT count(*) FROM ( \
    (SELECT * FROM read_parquet('${CONDITIONS_PARQUET}') EXCEPT ALL SELECT * FROM read_parquet('${WORK}/stored.parquet')) \
    UNION ALL \
    (SELECT * FROM read_parquet('${WORK}/stored.parquet') EXCEPT ALL SELECT * FROM read_parquet('${CONDITIONS_PARQUET}')));")"
  if [[ "${DIFFERENCES}" == "0" ]]; then
    UNCHANGED=true
  fi
  echo "Stored ${NEWEST_KEY}: ${DIFFERENCES} differing row(s)"
else
  echo "No stored conditions yet; this run publishes the first"
fi

if [[ "${CHECK_ONLY}" == true ]]; then
  if [[ "${UNCHANGED}" == true ]]; then
    echo "Up to date: the published conditions match the provider"
    exit 0
  fi
  echo "DRIFT: the provider's conditions differ from the newest stored partition" >&2
  echo >&2
  echo "Re-run without --check to publish a new as_of." >&2
  exit 1
fi

if [[ "${UNCHANGED}" == true ]]; then
  echo "Conditions unchanged; nothing published."
  exit 0
fi

AS_OF="$(date -u +%Y-%m-%d)"
DESTINATION_KEY="${PREFIX}/as_of=${AS_OF}/data.parquet"
echo "Publishing s3://${BUCKET}/${DESTINATION_KEY}"

# `--if-none-match "*"` so a second change on one UTC day refuses rather than overwrites. The key is
# date-only and `conditions_as_of` is the whole of a fold's rule provenance, so replacing it would
# silently change what every earlier run's record refers to -- and unlike the classification
# mapping, those runs cannot be re-read under the corrected table, because their fold is final.
if ! aws s3api put-object --bucket "${BUCKET}" --key "${DESTINATION_KEY}" \
  --body "${CONDITIONS_PARQUET}" --if-none-match "*" >/dev/null 2>"${WORK}/put_error"; then
  if grep -q "PreconditionFailed\|At least one of the pre-conditions" "${WORK}/put_error"; then
    echo "Error: as_of=${AS_OF} already holds a different table." >&2
    echo "  Overwriting it would change what earlier runs' conditions_as_of refers to, and those" >&2
    echo "  folds cannot be redone from the record." >&2
    echo "  Wait for the next UTC day, or delete that partition deliberately if nothing read it." >&2
  else
    cat "${WORK}/put_error" >&2
  fi
  exit 1
fi

echo "Done."
