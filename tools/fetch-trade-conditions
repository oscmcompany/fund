#!/usr/bin/env bash
# Regenerates src/data/conditions_table.rs from the provider's sale-condition reference.
#
# The table decides which trades enter volume, VWAP and the effective spread, so it is baked into
# the binary rather than fetched at fold time: a five-year backfill and tonight's nightly must apply
# the same rules, and a table that moves under a running pass would make two partitions written a day
# apart incomparable. Re-run this when the provider publishes new codes, and commit the diff.
#
#   secretspec run -- tools/fetch-trade-conditions
#   secretspec run -- tools/fetch-trade-conditions --check
#
# `--check` rewrites nothing and exits non-zero when the provider has moved, which is the drift
# detection a baked table would otherwise lack. Deliberately not a test: it needs the network and a
# credential, and a suite that fails when the vendor is down stops meaning anything.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Entered rather than merely resolved: `cargo fmt` below reads the manifest from the working
# directory, so a run from anywhere but the repository root would format nothing and say so quietly.
cd "${ROOT}"
OUTPUT="${ROOT}/src/data/conditions_table.rs"

CHECK_ONLY=false
if [[ "${1:-}" == "--check" ]]; then
  CHECK_ONLY=true
elif [[ -n "${1:-}" ]]; then
  echo "Usage: $(basename "$0") [--check]" >&2
  exit 1
fi

for variable in MASSIVE_BASE_URL MASSIVE_API_KEY; do
  if [[ -z "${!variable:-}" ]]; then
    echo "Error: ${variable} is not set; run under 'secretspec run --'" >&2
    exit 1
  fi
done

RESPONSE="$(mktemp)"
trap 'rm -f "${RESPONSE}"' EXIT

if [[ "${MASSIVE_BASE_URL}" != https://* ]]; then
  echo "Error: MASSIVE_BASE_URL is not https, so the credential would cross the wire in clear" >&2
  exit 1
fi

echo "Fetching sale conditions from ${MASSIVE_BASE_URL}"
# The key travels as a bearer header fed over stdin, so it reaches neither the query string nor
# `argv`. The header half matches `massive.rs:311` and the reason recorded there — reqwest prints the
# full URL when a decode fails, so a key in the URL reaches every log line reporting one. The stdin
# half is this script's own: an argument would sit in `ps` output for as long as the request runs,
# and a config file would put the credential on disk.
curl -sS --fail-with-body --config - -o "${RESPONSE}" <<CURL_CONFIGURATION
url = "${MASSIVE_BASE_URL}/v3/reference/conditions?asset_class=stocks&limit=1000"
header = "Authorization: Bearer ${MASSIVE_API_KEY}"
CURL_CONFIGURATION

TARGET="${OUTPUT}"
if [[ "${CHECK_ONLY}" == true ]]; then
  TARGET="$(mktemp)"
  trap 'rm -f "${RESPONSE}" "${TARGET}"' EXIT
fi

python3 - "${RESPONSE}" "${TARGET}" <<'PYTHON'
import json
import re
import sys
from datetime import date

response, output = sys.argv[1], sys.argv[2]
with open(response) as handle:
    payload = json.load(handle)

conditions = sorted(
    (row for row in payload.get("results", []) if row.get("type") == "sale_condition"),
    key=lambda row: row["id"],
)
if not conditions:
    sys.exit("Error: the response carried no sale conditions")

for row in conditions:
    rules = row.get("update_rules", {}).get("consolidated", {})
    for rule in ("updates_volume", "updates_high_low", "updates_open_close"):
        if rule not in rules:
            sys.exit(f"Error: condition {row['id']} is missing {rule}")


def character(row, tape):
    value = row.get("sip_mapping", {}).get(tape)
    if value is None:
        return "None"
    if len(value) != 1:
        sys.exit(f"Error: condition {row['id']} maps to {value!r} on {tape}, which is not one byte")
    return f"Some(b'{value}')" if value != "'" else "Some(b'\\'')"


lines = [
    "//! The provider's sale-condition table, generated — see `tools/fetch-trade-conditions`.",
    "//!",
    "//! Edit the script, never this file. [`FETCHED_ON`] carries the date it was read.",
    "",
    "use crate::data::conditions::SaleCondition;",
    "",
    "/// The date the provider's reference endpoint was last read into this file.",
    "///",
    "/// The only line in this file that changes with the clock, which is what lets `--check` compare",
    "/// two generations by ignoring exactly one line.",
    f'pub const FETCHED_ON: &str = "{date.today().isoformat()}";',
    "",
    "/// Every stock sale condition the provider publishes, ordered by identifier.",
    f"pub const SALE_CONDITIONS: [SaleCondition; {len(conditions)}] = [",
]
for row in conditions:
    rules = row["update_rules"]["consolidated"]
    lines.append("    SaleCondition {")
    lines.append(f"        identifier: {row['id']},")
    lines.append(f"        name: {json.dumps(row['name'])},")
    lines.append(f"        updates_volume: {str(rules['updates_volume']).lower()},")
    lines.append(f"        updates_high_low: {str(rules['updates_high_low']).lower()},")
    lines.append(f"        updates_open_close: {str(rules['updates_open_close']).lower()},")
    lines.append(f"        consolidated_tape_association: {character(row, 'CTA')},")
    lines.append(f"        unlisted_trading_privileges: {character(row, 'UTP')},")
    lines.append(f"        trade_data_dissemination: {character(row, 'FINRA_TDDS')},")
    lines.append("    },")
lines.append("];")
lines.append("")

rendered = "\n".join(lines)

# `--check` compares two generations by ignoring the one dated line, so a second one would make an
# unchanged table read as drift a day later. That is exactly the bug this guard exists to prevent,
# and it is asserted here rather than trusted because the failure only appears the next morning.
dated = [
    line
    for line in rendered.splitlines()
    if re.search(r"\d{4}-\d{2}-\d{2}", line) and not line.startswith("pub const FETCHED_ON")
]
if dated:
    sys.exit(
        "Error: the generated file carries a date outside FETCHED_ON, which would make --check "
        f"report drift every day: {dated}"
    )

with open(output, "w") as handle:
    handle.write(rendered)

print(f"Wrote {len(conditions)} sale conditions to {output}")
PYTHON

if [[ "${CHECK_ONLY}" == true ]]; then
  # Ignoring FETCHED_ON, which moves with the clock and says nothing about the provider. It is the
  # only dated line by construction — the generator refuses to emit a second one — so this compares
  # the table itself rather than the day it was read.
  undated() { grep -v '^pub const FETCHED_ON' "$1"; }
  if diff <(undated "${OUTPUT}") <(undated "${TARGET}") >/dev/null; then
    echo "Up to date: the committed table matches the provider"
    exit 0
  fi
  echo "DRIFT: the provider's table no longer matches the committed one" >&2
  diff <(undated "${OUTPUT}") <(undated "${TARGET}") >&2 || true
  echo >&2
  echo "Re-run without --check, review the diff, and commit it." >&2
  exit 1
fi

echo "Formatting"
cargo fmt -- "${OUTPUT}" 2>/dev/null || cargo fmt
echo "Done. Review the diff and commit it."
